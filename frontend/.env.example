# Laravel API (server side). On Vercel set it to the public backend URL, e.g. https://api.bakhtstroy.tj/api/v1
API_URL=http://localhost:8000/api/v1
# Same URL for the browser (cart, login forms)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# Public address of this site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Live chat — Laravel Reverb WebSocket (public app key only, never the secret)
NEXT_PUBLIC_REVERB_KEY=
NEXT_PUBLIC_REVERB_HOST=localhost
NEXT_PUBLIC_REVERB_PORT=8080
NEXT_PUBLIC_REVERB_SCHEME=http
