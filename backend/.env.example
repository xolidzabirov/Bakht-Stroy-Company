APP_NAME="Bakht Stroy"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Dushanbe
FRONTEND_URL=http://localhost:3000

APP_LOCALE=ru
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ru_RU

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5433
DB_DATABASE=bakht_stroy
DB_USERNAME=bakht
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
# Local: sync (no worker needed). Server: database or redis + "php artisan queue:work".
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Swagger UI outside local env (staging)
API_DOCS_PUBLIC=false

# Admin account (php artisan db:seed)
ADMIN_NAME="Администратор"
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Default country code for local phone numbers (992 — Tajikistan)
PHONE_COUNTRY_CODE=992

# API token lifetime in minutes (30 days)
SANCTUM_EXPIRATION=43200

# Image previews are generated right away (switch to queue in stage 6)
QUEUE_CONVERSIONS_BY_DEFAULT=false

# Products with stock at or below this value are "low stock" in the admin panel
LOW_STOCK_THRESHOLD=10

# Registration: reject emails whose domain has no mail server (MX)
EMAIL_DNS_CHECK=true

# Production: switch cache and queue to Redis (predis client, no PHP extension needed)
# CACHE_STORE=redis
# QUEUE_CONNECTION=redis

# Allowed browser origins for the API (comma separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Requests per minute to the API per user / IP
API_RATE_LIMIT=120

# Addresses of the Next.js server (BFF) that may pass the client IP in X-Forwarded-For
TRUSTED_PROXIES=127.0.0.1,::1
