# Copy to deploy/.env on the server and fill in. Never commit deploy/.env.
# Generate secrets on the server:  openssl rand -hex 24

# ---- Addresses ----
# Without your own domain use the free sslip.io names of the server IP, e.g. for 158.101.12.34:
#   SITE_DOMAIN=158-101-12-34.sslip.io   API_DOMAIN=api.158-101-12-34.sslip.io
# Later: SITE_DOMAIN=bakhtstroy.tj  API_DOMAIN=api.bakhtstroy.tj
SITE_DOMAIN=
API_DOMAIN=
# Optional second address of the site (Vercel demo), without https://
EXTRA_SITE_HOST=
# Email for Let's Encrypt (certificate expiry notices)
ACME_EMAIL=

# ---- Laravel ----
APP_NAME="Bakht Stroy"
# production — only real data; staging — also fills the demo catalog with db:seed
APP_ENV=production
APP_DEBUG=false
# php artisan key:generate --show   (or: echo "base64:$(openssl rand -base64 32)")
APP_KEY=
APP_LOCALE=ru
APP_FALLBACK_LOCALE=ru
SANCTUM_EXPIRATION=1440

# ---- Database (created automatically on first start) ----
DB_DATABASE=bakhtstroy
DB_USERNAME=bakhtstroy
DB_PASSWORD=

# ---- Live chat (Reverb). Any random strings; the KEY is public, the SECRET is not ----
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=

# ---- Main administrator: docker compose exec api php artisan admin:seed ----
ADMIN_NAME="Администратор"
ADMIN_EMAIL=
ADMIN_PHONE=
ADMIN_PASSWORD=

# ---- Email (registration and password codes). Gmail: an "App password" from myaccount.google.com/apppasswords ----
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SCHEME=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Bakht Stroy"

# ---- Telegram bot @BakhtStroyBot (manager notifications about new chat messages) ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=BakhtStroyBot
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_CODES_DRIVER=bot
TELEGRAM_GATEWAY_TOKEN=

# ---- Cache and sessions in PostgreSQL (no Redis needed) ----
CACHE_STORE=database
SESSION_DRIVER=database
FILESYSTEM_DISK=public
QUEUE_CONVERSIONS_BY_DEFAULT=false
